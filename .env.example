# ── Environment variable template ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit the actual .env file to version control.

# Flask environment: development | production | testing
FLASK_ENV=development

# A long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-deploy

# Database connection string.
# Default (SQLite): leave commented out – config.py sets it automatically.
# For PostgreSQL: postgresql://user:password@localhost:5432/resumex
# DATABASE_URL=sqlite:///resumex.db

# Server port (optional – defaults to 5000)
PORT=5000

